# Discord
TICKETBOT_TOKEN=dein_bot_token

# Datenbank
TICKETBOT_DB_URL=jdbc:postgresql://localhost:5432/lostticketbot
TICKETBOT_DB_USER=ticketbot
TICKETBOT_DB_PASSWORD=

# Storage-Kanal für Transcripts und Anhänge.
# MUSS auf LOST Family liegen: Boost-Stufe 3 erlaubt dort 100 MB pro Datei,
# der Bewerbungsserver ist ungeboostet und kann nur 10 MB.
TICKETBOT_STORAGE_GUILD_ID=733857906117574717
TICKETBOT_STORAGE_CHANNEL_ID=

# Kanal für Konsolenausgaben, analog zu den anderen LOST-Bots
TICKETBOT_LOG_CHANNEL_ID=
